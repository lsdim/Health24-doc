{
  "manifest_version": 3,
  "name": "Health24 IRP Helper",
  "version": "1.0",
  "description": "Автоматичний розподіл даних діагностичних звітів в таблиці ІРП",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/h24-doc-16.png",
      "48": "icons/h24-doc-48.png",
      "128": "icons/h24-doc-128.png"
    }
  },
  "icons": {
    "16": "icons/h24-doc-16.png",
    "48": "icons/h24-doc-48.png",
    "128": "icons/h24-doc-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://mis.h24.ua/*"],
      "js": ["constants.js", "content.js"],
      "css": ["content.css"]
    }
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*"
  ]
}
